{
  "manifest_version": 3,
  "name": "KenEasy Gemini MCP Auto Helper",
  "version": "1.0.0",
  "description": "Google Gemini MCP ????? v1.0.0???????????????????????????????????????????? 6 ??????",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KenEasy Gemini MCP Auto Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "defaults.js",
        "hud.js",
        "content.js"
      ],
      "css": [
        "hud.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

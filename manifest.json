{
  "manifest_version": 3,
  "name": "Gemini MCP Auto Helper",
  "version": "1.0.0",
  "description": "自动点击 Google Gemini 的 MCP 权限允许按钮与“继续”按钮，内置防刷额度熔断保护。",
  "permissions": ["storage"],
  "host_permissions": ["https://gemini.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gemini MCP Auto Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["defaults.js", "hud.js", "content.js"],
      "css": ["hud.css"],
      "run_at": "document_idle"
    }
  ]
}
